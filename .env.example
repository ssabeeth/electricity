# Copy to .env and adjust. Never commit .env.

# Where raw caches, the Parquet lake, the DuckDB warehouse and outputs live.
ELEC_DATA_DIR=./data
# First delivery day to ingest.
ELEC_HISTORY_START=2023-09-01
# Decision cutoff (UK local time on D-1) for delivery day D.
ELEC_CUTOFF_LOCAL=09:00
ELEC_LOG_LEVEL=INFO

# MLflow. Leave empty locally to use sqlite under $ELEC_DATA_DIR/mlflow.
MLFLOW_TRACKING_URI=

# dbt target: duckdb (default) or bigquery.
DBT_TARGET=duckdb

# BigQuery (only when DBT_TARGET=bigquery; see docs/bigquery.md).
GCP_PROJECT=
BQ_DATASET=elecprice
BQ_LOCATION=europe-west2
GOOGLE_APPLICATION_CREDENTIALS=

# Docker Compose. `make up` copies this file to .env and fills in random secrets.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me
AIRFLOW_FERNET_KEY=
# Host directory mounted at /data in every container.
ELEC_HOST_DATA_DIR=./data
# Published ports. (5000 is taken by AirPlay on macOS, hence MLflow on 5001.)
AIRFLOW_PORT=8080
MLFLOW_PORT=5001
API_PORT=8000
DASHBOARD_PORT=8501
