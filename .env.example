# Copy to .env and adjust. Never commit .env.

# Where raw caches, the Parquet lake, the DuckDB warehouse and outputs live.
ELEC_DATA_DIR=./data
# First delivery day to ingest.
ELEC_HISTORY_START=2023-09-01
# Decision cutoff (UK local time on D-1) for delivery day D.
ELEC_CUTOFF_LOCAL=09:00
ELEC_LOG_LEVEL=INFO

# MLflow. Leave empty locally to use sqlite under $ELEC_DATA_DIR/mlflow.
MLFLOW_TRACKING_URI=

# dbt target: duckdb (default) or bigquery.
DBT_TARGET=duckdb

# BigQuery (only when DBT_TARGET=bigquery; see docs/bigquery.md).
GCP_PROJECT=
BQ_DATASET=elecprice
BQ_LOCATION=europe-west2
GOOGLE_APPLICATION_CREDENTIALS=

# Docker Compose / Airflow. Change these before exposing anything.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
